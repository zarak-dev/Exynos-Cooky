# ============================================================
# EXYNOS-COOKY ENVIRONMENT CONFIGURATION
# ============================================================
# Vite frontend variables MUST begin with VITE_ to be exposed to client.
# NEVER place service-role keys or Grok API keys in this file!
# ============================================================

# Supabase Configuration (Safe Browser Publishable Key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional Custom Edge Function URL (defaults to ${VITE_SUPABASE_URL}/functions/v1/cooky-ai)
# VITE_SUPABASE_AI_FUNCTION_URL=
